<Window x:Class="DBDAutoReShade.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:cf="clr-namespace:DBDAutoReShade.App.Controls"
        xmlns:infra="clr-namespace:DBDAutoReShade.App.Infrastructure"
        xmlns:vm="clr-namespace:DBDAutoReShade.App.ViewModels"
        Title="DBD Auto ReShade — First-run setup" Width="620" Height="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource CfNightBrush}" Foreground="{StaticResource CfBoneBrush}"
        FontFamily="{StaticResource CfBodyFont}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- The first-run setup in the Campfire design: the same steps and fields as before (DBD, ReShade, the Global
         preset, the detection hotkey, realm presets later), plus the Global preset hotkey. 760 high by design; on a
         smaller screen it is fitted to the work area (its steps scroll), so the Finish bar stays on the screen. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <infra:BoolVisibilityConverter x:Key="Visible"/>
        <infra:HasValueConverter x:Key="HasValue"/>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CfLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,16,0,16"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource CfEmberBrush}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource CfSectionTitle}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StepValue" TargetType="TextBlock" BasedOn="{StaticResource CfBody}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <!-- Tab order: the steps, then Finish, then the window buttons (local tab indexes; the paint order stays) -->
    <Grid x:Name="Root" KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the atmosphere -->
        <cf:FogBackdrop Grid.Row="1" Grid.RowSpan="2" Layer="Backdrop" EmberLevel="0.5"/>
        <cf:FogBackdrop Grid.RowSpan="3" Layer="Bank"/>

        <!-- the title bar -->
        <Border Grid.Row="0" BorderBrush="#524A5C63" BorderThickness="0,0,0,1" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#0A1013"/>
                    <GradientStop Offset="1" Color="#0D1518"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <TextBlock Text="DBD Auto ReShade — First-run setup" Style="{StaticResource CfWindowTitle}" Margin="16,0,0,0" IsHitTestVisible="False"/>
                <StackPanel x:Name="WindowControls" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CfTitleBarButton}" cf:CampfireAssist.Icon="{StaticResource CfGlyphMinimize}"
                            AutomationProperties.Name="Minimize" ToolTip="Minimize" Click="OnMinimize"/>
                    <Button Style="{StaticResource CfTitleBarCloseButton}" cf:CampfireAssist.Icon="{StaticResource CfGlyphClose}"
                            AutomationProperties.Name="Close" ToolTip="Close" Click="OnFinish"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Steps" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
            <StackPanel Margin="32,26,32,8">
                <TextBlock Text="Welcome to DBD Auto ReShade" Style="{StaticResource CfDetailTitle}" FontSize="40" LineHeight="40"/>
                <TextBlock Text="A few quick steps. Realm presets are optional — unconfigured realms use the Global preset, if you set one in step 3."
                           Style="{StaticResource CfDescription}" Margin="0,10,0,18"/>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                        <StackPanel>
                            <TextBlock Text="Dead by Daylight" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="{Binding DbdPath}" Style="{StaticResource StepValue}"/>
                            <Button x:Name="FirstBrowseButton" Content="Browse" Command="{Binding BrowseDbdCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Browse for Dead by Daylight"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                        <StackPanel>
                            <TextBlock Text="ReShade" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="{Binding ReshadePath}" Style="{StaticResource StepValue}"/>
                            <Button Content="Browse" Command="{Binding BrowseReshadeCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Browse for ReShade.ini"/>
                            <!-- a path change that could not update ReShade.ini or be saved says so here -->
                            <TextBlock Text="{Binding PathsProblem}" Style="{StaticResource CfError}" Margin="0,10,0,0" cf:CampfireAssist.LiveRegion="Polite"
                                       Visibility="{Binding PathsProblem, Converter={StaticResource HasValue}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                        <StackPanel>
                            <TextBlock Text="Global / Menu preset" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="{Binding GlobalPresetName}" Style="{StaticResource StepValue}"/>
                            <Button Content="Select" Command="{Binding ChangeGlobalCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Select the Global preset"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <TextBlock Text="4" Style="{StaticResource StepNumber}"/>
                        <StackPanel>
                            <TextBlock Text="Detection hotkey" Style="{StaticResource StepTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <cf:Keycap Size="Large" Margin="0,0,16,0" VerticalAlignment="Center" IsCapturing="{Binding HotkeyCaptureMode}">
                                    <cf:Keycap.Style>
                                        <Style TargetType="cf:Keycap">
                                            <Setter Property="Text" Value="{Binding HotkeyText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HotkeyCaptureMode}" Value="True">
                                                    <Setter Property="Text" Value="…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </cf:Keycap.Style>
                                </cf:Keycap>
                                <Button Content="{Binding HotkeyButtonText}" Command="{Binding BeginHotkeyCaptureCommand}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding HotkeyButtonName}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static vm:MainViewModel.CaptureHelpText}" Style="{StaticResource CfDescription}" Foreground="{StaticResource CfBoneBrush}"
                                       Margin="0,10,0,0" Visibility="{Binding HotkeyCaptureMode, Converter={StaticResource Visible}}" cf:CampfireAssist.LiveRegion="Polite"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <TextBlock Text="5" Style="{StaticResource StepNumber}"/>
                        <StackPanel>
                            <TextBlock Text="Global preset hotkey" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Press it anywhere, in game too, to switch to the Global / Menu preset." Style="{StaticResource CfDescription}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <cf:Keycap Size="Large" Margin="0,0,16,0" VerticalAlignment="Center" IsCapturing="{Binding GlobalHotkeyCaptureMode}">
                                    <cf:Keycap.Style>
                                        <Style TargetType="cf:Keycap">
                                            <Setter Property="Text" Value="{Binding GlobalHotkeyText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalHotkeyCaptureMode}" Value="True">
                                                    <Setter Property="Text" Value="…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </cf:Keycap.Style>
                                </cf:Keycap>
                                <Button x:Name="GlobalHotkeyButton" Content="{Binding GlobalHotkeyButtonText}" Command="{Binding BeginGlobalHotkeyCaptureCommand}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding GlobalHotkeyButtonName}"/>
                                <Button Content="Clear" Style="{StaticResource CfButtonGhost}" Command="{Binding ClearGlobalHotkeyCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Clear the Global preset hotkey" cf:CampfireAssist.FocusOnLeave="{Binding ElementName=GlobalHotkeyButton}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static vm:MainViewModel.CaptureHelpText}" Style="{StaticResource CfDescription}" Foreground="{StaticResource CfBoneBrush}"
                                       Margin="0,10,0,0" Visibility="{Binding GlobalHotkeyCaptureMode, Converter={StaticResource Visible}}" cf:CampfireAssist.LiveRegion="Polite"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <TextBlock Text="6" Style="{StaticResource StepNumber}"/>
                        <StackPanel>
                            <TextBlock Text="Realm presets (optional)" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="{Binding ScanHelpText, StringFormat='Assign per-realm presets later under the Presets tab. {0} No screenshots or templates needed.'}"
                                       Style="{StaticResource CfDescription}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource CfLineBrush}" BorderThickness="0,1,0,0" Padding="32,14,32,18"
                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
            <Button x:Name="FinishButton" Content="Finish" Style="{StaticResource CfButtonPrimary}" Click="OnFinish" HorizontalAlignment="Right" Padding="28,0" IsDefault="True"/>
        </Border>
    </Grid>
</Window>
