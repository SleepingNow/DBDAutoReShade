<Application x:Class="DBDAutoReShade.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!--
        Theming: the Campfire theme (Themes/Campfire.xaml, the approved "a-campfire" prototype) is the only theme.
        It holds the tokens, the type ramp and the control templates, applied implicitly to every Button, CheckBox,
        Slider, TextBox, ComboBox (+ items), ScrollBar, ScrollViewer, ToolTip, ListBox (+ items), ContextMenu and
        MenuItem, so nothing ever falls back to the light Windows templates. There is deliberately no implicit
        TextBlock style (it would reach the text inside other controls' templates).
        Windows and views built without this Application (tests, tools) merge the same dictionary themselves
        (Media/CampfireTheme.EnsureFor).
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DBDAutoReShade;component/Themes/Campfire.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
