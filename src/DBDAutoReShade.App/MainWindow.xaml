<Window x:Class="DBDAutoReShade.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:DBDAutoReShade.App.Infrastructure"
        Title="DBD Auto ReShade" Height="640" Width="600" MinHeight="520" MinWidth="480"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DBD Auto ReShade" FontSize="20" FontWeight="Bold" Margin="0,0,0,2" />
        <TextBlock Grid.Row="0" Text="Realm-based ReShade presets for Dead by Daylight (local OCR)"
                   Style="{StaticResource MutedText}" Margin="0,28,0,8" />

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="#3A2A1A" BorderBrush="#D9A441" BorderThickness="1" CornerRadius="4"
                    Padding="8" Margin="0,0,0,6"
                    Visibility="{Binding ShowRestartNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding RestartNoticeText}" Foreground="#F2C879" TextWrapping="Wrap" />
            </Border>
            <Border Background="#3A1D1B" BorderBrush="#C8322B" BorderThickness="1" CornerRadius="4"
                    Padding="8" Margin="0,0,0,6"
                    Visibility="{Binding BannerError, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding BannerError}" Foreground="#F0968F" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Status">
                <StackPanel Margin="6">
                    <TextBlock Text="{Binding ScanHelpText}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <GroupBox Header="Match">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DBD Status:" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DbdStatus}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Detection:" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetectionText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Detected Map:" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetectedMap}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Detected Realm:" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetectedRealm}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Active Preset:" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActivePreset}" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Auto Switching:" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AutoSwitching}" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Last Activation">
                        <TextBlock Text="{Binding LastActivation}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                    </GroupBox>
                    <GroupBox Header="Manual Override">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ComboBox Width="250" ItemsSource="{Binding AvailableRealms}"
                                          SelectedItem="{Binding SelectedOverrideRealm, Mode=TwoWay}"
                                          IsEditable="False" />
                                <Button Content="Apply" Command="{Binding ApplyOverrideCommand}" />
                                <Button Content="Return to Automatic" Command="{Binding ReturnToAutoCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding OverrideHelpText}"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Presets">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Global / Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GlobalPresetName}" VerticalAlignment="Center" Width="260" TextTrimming="CharacterEllipsis" />
                                <Button Content="Change" Command="{Binding ChangeGlobalCommand}" />
                                <Button Content="Test" Command="{Binding TestGlobalCommand}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Realms">
                            <ItemsControl ItemsSource="{Binding RealmRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RealmName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding PresetName}" VerticalAlignment="Center"
                                                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Content="Change" Command="{Binding SelectCommand}" />
                                            <Button Grid.Column="3" Content="Test" Command="{Binding TestCommand}" />
                                            <Button Grid.Column="4" Content="✕" Command="{Binding ClearCommand}" ToolTip="{Binding ClearToolTip}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Detection Hotkey">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding HotkeyText}" VerticalAlignment="Center" Width="160" FontWeight="Bold" />
                                    <Button Content="Change" Command="{Binding BeginHotkeyCaptureCommand}" />
                                </StackPanel>
                                <TextBlock Text="Press the new hotkey: F1–F24, or Ctrl/Alt/Shift + a letter, number or NumPad key. Esc cancels. (The current hotkey is paused meanwhile.)"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HotkeyCaptureMode, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Paths">
                            <StackPanel>
                                <TextBlock Text="Dead by Daylight" Style="{StaticResource MutedText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Text="{Binding DbdPath, Mode=OneWay}" Width="360" IsReadOnly="True" />
                                    <Button Content="Browse" Command="{Binding BrowseDbdCommand}" />
                                </StackPanel>
                                <TextBlock Text="ReShade.ini" Style="{StaticResource MutedText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding ReshadePath, Mode=OneWay}" Width="360" IsReadOnly="True" />
                                    <Button Content="Browse" Command="{Binding BrowseReshadeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Behavior">
                            <StackPanel>
                                <CheckBox Content="Restore Global preset when the match ends" IsChecked="{Binding AutoRestore, Mode=TwoWay}" />
                                <CheckBox IsChecked="{Binding DebugMode, Mode=TwoWay}">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Debug Mode: when a scan ends without a confident read (failed or stopped), save that scan's last OCR crops and their OCR text locally to %AppData%\DBDAutoReShade\debug-crops (newest 20 sets kept)" />
                                </CheckBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Map Database">
                            <StackPanel>
                                <TextBlock Text="{Binding DatabaseText}" Margin="0,0,0,6" />
                                <TextBlock Text="Update manifest URL (must be an https:// address; leave empty to disable):"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding ManifestUrl, Mode=TwoWay}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ManifestUrlError}" Style="{StaticResource ErrorText}" Margin="0,4,0,0"
                                           Visibility="{Binding ManifestUrlError, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="ReShade Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Verifies ReShade.ini, the hook DLL, stored shortcuts and preset files."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Run checks" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,0,0" />
                                    <Button Content="Copy" Command="{Binding CopyDiagnosticsCommand}" />
                                </StackPanel>
                                <TextBox Text="{Binding DiagnosticsReport, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" Height="160" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                        <Button Content="Reset Settings" Command="{Binding ResetSettingsCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,6,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
