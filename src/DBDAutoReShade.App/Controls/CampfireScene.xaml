<UserControl x:Class="DBDAutoReShade.App.Controls.CampfireScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             IsHitTestVisible="False"
             Focusable="False">
    <!--
        The campfire clearing (Global / Menu, and the Status plate with no map), ported from the Campfire prototype's
        campfireArt(): a 400 x 200 vector scene drawn UniformToFill (SVG preserveAspectRatio "xMidYMid slice").
        The treeline, the dead tree and the Entity standing in the far fog are the prototype's generated path data
        (dumped with headless Chromium). Everything around the fire is drawn relative to the fire (FireX), so the
        scene can put the fire anywhere (the Status plate uses 304, the Global row 200, the Presets hero 292).
        Layers that differ between the fire states are separate (cold / warm pit, lit glow / ember glow), so every
        change between Out, Embers and Burning is an in-place crossfade plus the fire's own motion.
    -->
    <UserControl.Resources>
        <RadialGradientBrush x:Key="SceneMist" po:Freeze="True" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#944A5C63"/>
            <GradientStop Offset="1" Color="#004A5C63"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="SceneFireLight" po:Freeze="True" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#8CF08A3C"/>
            <GradientStop Offset="1" Color="#00F08A3C"/>
        </RadialGradientBrush>
    </UserControl.Resources>
