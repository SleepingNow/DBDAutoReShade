<UserControl x:Class="DBDAutoReShade.App.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cf="clr-namespace:DBDAutoReShade.App.Controls"
             xmlns:infra="clr-namespace:DBDAutoReShade.App.Infrastructure"
             xmlns:vm="clr-namespace:DBDAutoReShade.App.ViewModels"
             xmlns:media="clr-namespace:DBDAutoReShade.App.Media"
             xmlns:services="clr-namespace:DBDAutoReShade.App.Services"
             x:Name="Root"
             AutomationProperties.Name="Presets">
    <!--
        Presets (the prototype's .presets): left, the filter box, the pinned Global / Menu row and the realm list
        (map strip, realm, preset file or what happens without one, map count, a dot for the active / detected realm or
        a restart); one selection bar per list glides between rows. Right, the selected row's detail: the title with the
        map count and its tag, the hero picture (2:1, never wider than 1.8 x the picture: a narrower frame sits on the
        left and the fog fills the rest, while the preset panel keeps the column's width) with its name, clickable
        thumbnails of the realm's maps (never wider than the picture itself: on a wide window they stop growing and
        sit on the left), and the preset panel (Test with the 15 s countdown ring, Change file, Clear).
    -->
    <UserControl.Resources>
        <infra:BoolVisibilityConverter x:Key="Visible"/>
        <infra:BoolVisibilityConverter x:Key="Hidden" Invert="True"/>
        <infra:HasValueConverter x:Key="HasValue"/>
        <infra:EnumMatchConverter x:Key="Is"/>
        <infra:EnumMatchConverter x:Key="IsNot" Invert="True"/>
        <infra:EnumNameConverter x:Key="EnumName"/>

        <LinearGradientBrush x:Key="SelectionBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F6D3AE"/>
            <GradientStop Offset="1" Color="#F08A3C"/>
        </LinearGradientBrush>

        <!-- the realm rows' texts -->
        <Style x:Key="RowPreset" TargetType="TextBlock" BasedOn="{StaticResource CfRowPreset}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnset}" Value="True">
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsRestart}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CfEntityInkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsReshadeIni}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CfEntityInkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowMeta" TargetType="TextBlock" BasedOn="{StaticResource CfRowMeta}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMetaHit}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowStrip" TargetType="cf:MapStrip">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="FrameBrush" Value="#80E3DCCD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowMark" TargetType="cf:StatusDot">
            <Setter Property="Kind" Value="{Binding Mark, Converter={StaticResource EnumName}, FallbackValue=Ember}"/>
            <Setter Property="Visibility" Value="{Binding Mark, Converter={StaticResource IsNot}, ConverterParameter=None}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- a realm row -->
        <DataTemplate x:Key="RealmRowTemplate" DataType="{x:Type vm:RealmRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="12"/>
                </Grid.ColumnDefinitions>
                <cf:MapStrip MapNames="{Binding MapNames}" IsFogged="{Binding IsUnset}" Style="{StaticResource RowStrip}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RealmName}" Style="{StaticResource CfRowName}" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock Text="{Binding PresetText}" Style="{StaticResource RowPreset}" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource RowMeta}" Margin="0,1,0,0"/>
                </StackPanel>
                <cf:StatusDot Grid.Column="4" Style="{StaticResource RowMark}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="RealmItem" TargetType="ListBoxItem" BasedOn="{StaticResource CfRealmRow}">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Visible}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
        </Style>

        <!-- the pinned Global / Menu row: a row-shaped button -->
        <Style x:Key="PinnedRow" TargetType="Button" BasedOn="{StaticResource CfPlainButton}">
            <Setter Property="Padding" Value="18,8,16,8"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisualRow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CfRowHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding GlobalRow.IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CfSelectedBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a thumbnail: picture 2:1 over its name; a two-map realm uses a picture + name card -->
        <Style x:Key="ThumbFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Opacity" Value="0.74"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource CfBoneBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThumbName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="17.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- (a thumbnail is never enlarged: its frame is at most the narrowest picture's width in physical pixels, and the
             list is no wider than its thumbnails; its state is told to assistive technology as its item status) -->
        <DataTemplate x:Key="ThumbTemplate" DataType="{x:Type vm:MapThumb}">
            <Button Style="{StaticResource CfPlainButton}" Command="{Binding SelectCommand}"
                    AutomationProperties.Name="{Binding Name}" AutomationProperties.ItemStatus="{Binding StatusText}"
                    Margin="0,0,10,0" Click="OnThumbClick">
                <StackPanel>
                    <Grid HorizontalAlignment="Left">
                        <Border Style="{StaticResource ThumbFrame}" ClipToBounds="True">
                            <cf:AspectFrame MinAspect="2" MaxAspect="2" MaxWidthPixels="{x:Static services:MapImageCatalog.ThumbnailMaxWidthPixels}">
                                <cf:MapPicture MapName="{Binding Name}"/>
                            </cf:AspectFrame>
                        </Border>
                        <cf:StatusDot Kind="Ember" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                      Visibility="{Binding IsDetected, Converter={StaticResource Visible}}"/>
                    </Grid>
                    <TextBlock x:Name="ThumbNameText" Text="{Binding Name}" Style="{StaticResource ThumbName}" Margin="0,6,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="PairThumbTemplate" DataType="{x:Type vm:MapThumb}">
            <Button Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}" AutomationProperties.ItemStatus="{Binding StatusText}"
                    Margin="0,0,10,0" Click="OnThumbClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CfPlainButton}">
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card" Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource CfLineBrush}" BorderThickness="1" CornerRadius="2" Background="#8C0B1114">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#8CE3DCCD"/>
                                            <Setter TargetName="Card" Property="Background" Value="#12E3DCCD"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" MinWidth="104" MaxWidth="168"/>
                        <ColumnDefinition Width="56*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Border Style="{StaticResource ThumbFrame}" ClipToBounds="True">
                            <cf:AspectFrame MinAspect="2" MaxAspect="2" MaxWidthPixels="{x:Static services:MapImageCatalog.ThumbnailMaxWidthPixels}">
                                <cf:MapPicture MapName="{Binding Name}"/>
                            </cf:AspectFrame>
                        </Border>
                        <cf:StatusDot Kind="Ember" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                      Visibility="{Binding IsDetected, Converter={StaticResource Visible}}"/>
                    </Grid>
                    <TextBlock x:Name="ThumbNameText" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource ThumbName}" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="358"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== the realm list ===== -->
        <Border BorderBrush="{StaticResource CfLineBrush}" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#DB0A0F12"/>
                    <GradientStop Offset="1" Color="#B30A0F12"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="Filter" Margin="16,20,16,12" Padding="36,0,12,0"
                         cf:CampfireAssist.Placeholder="Filter by realm or map" cf:CampfireAssist.Icon="{StaticResource CfIconSearch}"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Filter realms by realm or map name"/>

                <Border Grid.Row="1" BorderBrush="{StaticResource CfLineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                    <Grid>
                        <Button x:Name="GlobalRowButton" Style="{StaticResource PinnedRow}"
                                Command="{Binding SelectRowCommand}" CommandParameter="{Binding GlobalRow}"
                                AutomationProperties.Name="{Binding GlobalRow.AccessibleName}"
                                PreviewKeyDown="OnGlobalRowKeyDown">
                            <Grid DataContext="{Binding GlobalRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="12"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="104" Height="52" BorderBrush="{StaticResource CfLineBrush}" BorderThickness="1" ClipToBounds="True" SnapsToDevicePixels="True">
                                    <cf:CampfireScene x:Name="GlobalTile" FireState="Burning" FireX="200" IsLive="False" AnimateChanges="False"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Global / Menu" Style="{StaticResource CfRowNameGlobal}"/>
                                    <TextBlock Text="{Binding PresetText}" Style="{StaticResource RowPreset}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <cf:StatusDot Grid.Column="4" Style="{StaticResource RowMark}"/>
                            </Grid>
                        </Button>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="PinnedIndicator" Width="3" Height="40" Fill="{StaticResource SelectionBarBrush}" Opacity="0">
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="#F08A3C" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
                                </Rectangle.Effect>
                            </Rectangle>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox x:Name="RealmList" ItemsSource="{Binding RealmRows}" SelectedItem="{Binding SelectedRealmRow, Mode=TwoWay}"
                             ItemTemplate="{StaticResource RealmRowTemplate}" ItemContainerStyle="{StaticResource RealmItem}"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                             AutomationProperties.Name="Realms" PreviewKeyDown="OnRealmListKeyDown"
                             PreviewMouseLeftButtonDown="OnRealmListPointerDown">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer x:Name="RowsScroller" Focusable="False" CanContentScroll="False" Padding="0,6,0,16">
                                    <Grid>
                                        <ItemsPresenter/>
                                        <Canvas IsHitTestVisible="False">
                                            <Rectangle x:Name="Indicator" Width="3" Height="40" Fill="{StaticResource SelectionBarBrush}" Opacity="0">
                                                <Rectangle.Effect>
                                                    <DropShadowEffect Color="#F08A3C" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
                                                </Rectangle.Effect>
                                            </Rectangle>
                                        </Canvas>
                                    </Grid>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                    </ListBox>
                    <StackPanel Margin="18" Visibility="{Binding HasFilterMatches, Converter={StaticResource Hidden}}">
                        <TextBlock Text="{Binding FilterEmptyText}" Style="{StaticResource CfDescription}"/>
                        <Button x:Name="ClearFilterButton" Content="Clear filter" Style="{StaticResource CfButtonSecondarySmall}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding ClearFilterCommand}" cf:CampfireAssist.FocusOnLeave="{Binding ElementName=Filter}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== the detail ===== -->
        <ScrollViewer x:Name="DetailScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="Detail" Margin="36,24,40,30">
                <!-- the head: title, map count, tag. The count and the tag are small text straight over the backdrop (its
                     map can be bright, the Entity's rim can cross them): a soft night shade sits under them. -->
                <WrapPanel Margin="0,0,0,14">
                    <TextBlock x:Name="DetailTitleText" Text="{Binding DetailTitle}" Style="{StaticResource CfDetailTitle}" Margin="0,0,16,0" VerticalAlignment="Bottom"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <Grid x:Name="DetailMeta" Margin="0,0,0,6" VerticalAlignment="Bottom">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DetailCountText}" Value=""/>
                                            <Condition Binding="{Binding DetailTagKind}" Value="{x:Static vm:RowMark.None}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle x:Name="DetailMetaShade" Style="{StaticResource CfTextShade}" Margin="-16,-10,-16,-10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailCountText" Text="{Binding DetailCountText}" Margin="0,0,16,0" VerticalAlignment="Bottom"
                                       FontFamily="{StaticResource CfBodyFont}" FontWeight="Medium" FontSize="14" Foreground="{StaticResource CfAshBrush}"
                                       Visibility="{Binding DetailCountText, Converter={StaticResource HasValue}}"/>
                            <StackPanel x:Name="DetailTag" Orientation="Horizontal" VerticalAlignment="Bottom"
                                        Visibility="{Binding DetailTagKind, Converter={StaticResource IsNot}, ConverterParameter=None}">
                                <cf:StatusDot Kind="{Binding DetailTagKind, Converter={StaticResource EnumName}, FallbackValue=Ember}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DetailTagText" Text="{Binding DetailTagText}" Style="{StaticResource CfTag}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </WrapPanel>
                <TextBlock Text="{Binding GlobalExplain}" Style="{StaticResource CfBody}" Opacity="0.88" MaxWidth="560" HorizontalAlignment="Left" Margin="0,-8,0,14"
                           Visibility="{Binding DetailIsGlobal, Converter={StaticResource Visible}}"/>

                <!-- the hero picture: the glow and the art share the (capped) frame -->
                <Grid x:Name="HeroHost">
                    <cf:AspectFrame x:Name="HeroFrame" MinAspect="2" MaxAspect="2" FrameAlignment="Left">
                        <Grid x:Name="HeroCard">
                            <Border x:Name="HeroGlow" CornerRadius="2" Background="#0B1114">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailIsLive}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect Color="#F08A3C" BlurRadius="30" ShadowDepth="0" Opacity="0.18"/>
                                </Border.Effect>
                            </Border>
                            <Grid x:Name="HeroArt" ClipToBounds="True">
                                <cf:MapPicture x:Name="HeroPicture" Margin="1" MapName="{Binding HeroMap}" PlaceholderLabel="Unavailable"
                                               Visibility="{Binding DetailIsGlobal, Converter={StaticResource Hidden}}"/>
                                <!-- the clearing burns while Dead by Daylight runs, and is out otherwise (the prototype's lit / cold) -->
                                <cf:CampfireScene x:Name="HeroCampfire" Margin="1" FireX="292" IsLive="False" AnimateChanges="False"
                                                  Visibility="{Binding DetailIsGlobal, Converter={StaticResource Visible}}">
                                    <cf:CampfireScene.Style>
                                        <Style TargetType="cf:CampfireScene">
                                            <Setter Property="FireState" Value="Out"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalFireBurning}" Value="True">
                                                    <Setter Property="FireState" Value="Burning"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </cf:CampfireScene.Style>
                                </cf:CampfireScene>
                                <Grid x:Name="HeroCaption" VerticalAlignment="Bottom" Margin="1" IsHitTestVisible="False">
                                    <Border x:Name="HeroShade">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#000B1114"/>
                                                <GradientStop Offset="0.64" Color="#DB0B1114"/>
                                                <GradientStop Offset="1" Color="#DB0B1114"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <DockPanel Margin="18,40,18,14" LastChildFill="False">
                                        <TextBlock x:Name="HeroMapText" DockPanel.Dock="Left" Style="{StaticResource CfHeroMap}" VerticalAlignment="Bottom"
                                                   Text="{Binding HeroMap, TargetNullValue='Menus and lobby'}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,2"
                                                    Visibility="{Binding HeroIsDetected, Converter={StaticResource Visible}}">
                                            <cf:StatusDot Kind="Ember" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Detected map" Style="{StaticResource CfTag}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <Border x:Name="HeroBorder" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource CfLineStrongBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailIsLive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource CfLiveBorderBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            <!-- the ember confirm's strokes (drawn while a confirm plays) -->
                            <Canvas x:Name="HeroSweep" IsHitTestVisible="False" Opacity="0"/>
                        </Grid>
                    </cf:AspectFrame>
                </Grid>

                <!-- the realm's maps -->
                <ItemsControl x:Name="ThumbList" ItemsSource="{Binding Thumbs}" Margin="0,12,-10,0" Focusable="False"
                              AutomationProperties.Name="Maps in the realm"
                              Visibility="{Binding HasThumbs, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="{Binding DataContext.ThumbColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource ThumbTemplate}"/>
                            <!-- as wide as its (capped) thumbnails; the two-map cards share the column -->
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThumbsArePair}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource PairThumbTemplate}"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>

                <!-- the preset panel -->
                <Border x:Name="PresetPanel" Style="{StaticResource CfPanel}" Margin="0,18,0,0" Padding="20,16,20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Preset file" Style="{StaticResource CfLabel}"/>
                            <TextBlock Text="{Binding DetailPresetText}" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CfPresetFile}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailHasPreset}" Value="False">
                                                <Setter Property="FontSize" Value="17"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                                <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource CfBodyFont}" FontSize="13" Foreground="{StaticResource CfAshBrush}" TextWrapping="Wrap">
                                <Run Text="{Binding DetailShortcutPrefix, Mode=OneWay}"/>
                                <Run Text="{Binding DetailShortcutValue, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CfBoneBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="TestButton" Content="Test" Style="{StaticResource CfButtonPrimary}" Command="{Binding TestSelectedCommand}"/>
                            <Button x:Name="ChangeFileButton" Content="{Binding ChangeFileText}" Margin="8,0,0,0" Command="{Binding ChangeSelectedCommand}"/>
                            <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource CfButtonGhost}" Margin="8,0,0,0" Command="{Binding ClearSelectedCommand}"/>
                        </WrapPanel>

                        <!-- feedback: the Test countdown, the clear question, or a message -->
                        <Border x:Name="FeedbackArea" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="0,12,0,0"
                                BorderBrush="{StaticResource CfLineBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding Feedback.Kind, Converter={StaticResource IsNot}, ConverterParameter=None}">
                            <Grid>
                                <StackPanel x:Name="TestFeedback" Orientation="Horizontal"
                                            Visibility="{Binding Feedback.Kind, Converter={StaticResource Is}, ConverterParameter=Test}">
                                    <cf:CountdownRing x:Name="TestRing" VerticalAlignment="Center"/>
                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource CfBody}" FontSize="14">
                                        <Run Text="Click into Dead by Daylight within"/>
                                        <Run Text="{Binding SecondsLeft, ElementName=TestRing, Mode=OneWay}"/>
                                        <Run Text="s to test"/>
                                        <Run Text="{Binding Feedback.File, Mode=OneWay}"/><Run Text="…"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel x:Name="ClearConfirmPanel" Visibility="{Binding Feedback.Kind, Converter={StaticResource Is}, ConverterParameter=ClearConfirm}">
                                    <TextBlock x:Name="ClearQuestionText" Text="{Binding Feedback.Text}" Style="{StaticResource CfBody}" FontSize="14" cf:CampfireAssist.LiveRegion="Polite"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="ConfirmClearButton" Content="Clear preset" Style="{StaticResource CfButtonDangerSmall}" Command="{Binding ConfirmClearCommand}"/>
                                        <Button Content="Keep it" Style="{StaticResource CfButtonSecondarySmall}" Margin="8,0,0,0" Command="{Binding CloseFeedbackCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="FeedbackMessageText" Text="{Binding Feedback.Text}" Style="{StaticResource CfBody}" FontSize="14" cf:CampfireAssist.LiveRegion="Polite"
                                           Visibility="{Binding Feedback.Kind, Converter={StaticResource Is}, ConverterParameter=Message}"/>
                            </Grid>
                        </Border>

                        <!-- the blocked flag: what fixes it (a DBD restart, or first the right ReShade.ini) -->
                        <Border x:Name="BlockedFlag" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CfFlagBar}" Margin="-20,12,-20,-16"
                                Visibility="{Binding DetailFlagText, Converter={StaticResource HasValue}}">
                            <DockPanel>
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource CfIconHook}" Stroke="{StaticResource CfBoneBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="BlockedFlagText" Text="{Binding DetailFlagText}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           FontFamily="{StaticResource CfBodyFont}" FontWeight="Medium" FontSize="14" Foreground="{StaticResource CfBoneBrush}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
