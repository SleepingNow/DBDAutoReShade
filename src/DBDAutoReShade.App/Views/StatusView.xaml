<UserControl x:Class="DBDAutoReShade.App.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cf="clr-namespace:DBDAutoReShade.App.Controls"
             xmlns:infra="clr-namespace:DBDAutoReShade.App.Infrastructure"
             x:Name="Root"
             AutomationProperties.Name="Status">
    <!--
        Status (the prototype's .status): the banners, the state hero and its status line, the facts (active preset,
        detection, last switch) beside the map plate (picture or campfire clearing, with the skill check on it), and
        the manual override bar at the bottom. The hero, the facts and the plate show Presented (a StatusScreen the
        window presents: it holds the previous one while the skill check lands); the banners and the override bar
        bind the view model directly. Sizes are the prototype's at 1280 x 800; the window's size adjusts the paddings,
        the plate width (the prototype's plate-w formula) and the override layout (OnLayoutSizeChanged).
    -->
    <UserControl.Resources>
        <infra:BoolVisibilityConverter x:Key="Visible"/>
        <infra:HasValueConverter x:Key="HasValue"/>
        <infra:HasValueConverter x:Key="NoValue" Invert="True"/>
        <infra:EnumNameConverter x:Key="EnumName"/>
        <infra:EnumMatchConverter x:Key="Is"/>
        <Style x:Key="FactsRow" TargetType="Border">
            <Setter Property="Padding" Value="0,10,0,11"/>
            <Setter Property="BorderBrush" Value="{StaticResource CfLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="ActiveFileText" TargetType="cf:CrossfadeText">
            <Setter Property="Swap" Value="BlurSoft"/>
            <Setter Property="TextStyle" Value="{StaticResource CfFileName}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveFile}" Value="{x:Null}">
                    <Setter Property="TextStyle">
                        <Setter.Value>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CfFileName}">
                                <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="Page" Margin="44,34,48,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- the banner area: the restart notice and hotkey problems -->
            <StackPanel x:Name="Banners" Grid.Row="0">
                <cf:RestartBanner x:Name="RestartBanner" Margin="0,0,0,22"
                                  Text="{Binding RestartNoticeText}" IsOpen="{Binding ShowRestartNotice}"
                                  ActionText="Show in Presets" ActionCommand="{Binding ShowRestartInPresetsCommand}"/>
                <cf:RestartBanner x:Name="HotkeyBanner" Margin="0,0,0,22"
                                  Text="{Binding BannerError, TargetNullValue=''}" IsOpen="{Binding BannerError, Converter={StaticResource HasValue}}"
                                  ActionText="Open Settings" ActionClick="OnOpenSettings"/>
            </StackPanel>

            <!-- the state hero and its status line -->
            <StackPanel x:Name="Hero" Grid.Row="1" HorizontalAlignment="Left" MaxWidth="820"
                        DataContext="{Binding Presented, ElementName=Root}">
                <cf:CrossfadeText x:Name="HeroText" HorizontalAlignment="Left" Text="{Binding Hero}" TextStyle="{StaticResource CfHeroXL}" Swap="BlurRise"
                                  AutomationProperties.HeadingLevel="Level1"/>
                <!-- the status line is small text straight over the backdrop (its map can be bright): a soft night shade
                     sits under it -->
                <Grid x:Name="MessageArea" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Rectangle x:Name="MessageShade" Style="{StaticResource CfTextShade}" Margin="-16,-10,-16,-10"
                               Visibility="{Binding Message, Converter={StaticResource HasValue}}"/>
                    <cf:CrossfadeText x:Name="MessageText" HorizontalAlignment="Left" Text="{Binding Message}" TextStyle="{StaticResource CfHeroMessage}" Swap="Fade"
                                      cf:CampfireAssist.LiveRegion="Polite"/>
                </Grid>
            </StackPanel>

            <!-- the facts beside the map plate -->
            <Grid x:Name="StatusGrid" Grid.Row="2" Margin="0,28,0,28" VerticalAlignment="Top"
                  DataContext="{Binding Presented, ElementName=Root}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="GapColumn" Width="36"/>
                    <ColumnDefinition x:Name="PlateColumn" Width="634"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Facts" Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Active preset" Style="{StaticResource CfLabel}" LineHeight="19.6"/>
                    <WrapPanel Margin="0,4,0,0">
                        <cf:CrossfadeText x:Name="ActiveFileText" Style="{StaticResource ActiveFileText}" VerticalAlignment="Center"
                                          Text="{Binding ActiveFile, TargetNullValue='No preset switched yet', FallbackValue='No preset switched yet'}"/>
                        <ContentControl Content="Override" Style="{StaticResource CfPillRed}" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Tail, Converter={StaticResource Is}, ConverterParameter=Override}"/>
                    </WrapPanel>

                    <StackPanel x:Name="ConfirmedLine" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding Tail, Converter={StaticResource Is}, ConverterParameter=Confirmed}">
                        <cf:StatusDot x:Name="ConfirmedDot" Kind="Ember" VerticalAlignment="Center"/>
                        <TextBlock Text="Confirmed by ReShade" Margin="10,0,0,0" FontFamily="{StaticResource CfBodyFont}"
                                   FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource CfEmberBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DockPanel x:Name="PendingLine" Margin="0,10,0,0" Visibility="{Binding Tail, Converter={StaticResource Is}, ConverterParameter=Pending}">
                        <cf:StatusDot Kind="Ring" IsHeartbeat="True" VerticalAlignment="Top" Margin="0,6,10,0"/>
                        <TextBlock FontFamily="{StaticResource CfBodyFont}" FontSize="14" Foreground="{StaticResource CfBoneBrush}" TextWrapping="Wrap">
                            <Run Text="Next:"/> <Run Text="{Binding TailSubject, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="when the game has focus"/>
                        </TextBlock>
                    </DockPanel>
                    <DockPanel x:Name="OverrideLine" Margin="0,10,0,0" Visibility="{Binding Tail, Converter={StaticResource Is}, ConverterParameter=Override}">
                        <cf:StatusDot Kind="Red" VerticalAlignment="Top" Margin="0,6,10,0"/>
                        <TextBlock FontFamily="{StaticResource CfBodyFont}" FontSize="14" Foreground="{StaticResource CfBoneBrush}" TextWrapping="Wrap">
                            <Run Text="Forced for"/> <Run Text="{Binding TailSubject, Mode=OneWay}"/> <Run Text="until you return to automatic"/>
                        </TextBlock>
                    </DockPanel>

                    <Border x:Name="FactsLines" Margin="0,20,0,0" BorderBrush="{StaticResource CfLineBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Border x:Name="DetectionRow" Style="{StaticResource FactsRow}">
                                <StackPanel>
                                    <TextBlock Text="Detection" Style="{StaticResource CfLabel}" LineHeight="19.6" Margin="0,0,0,3"/>
                                    <DockPanel x:Name="DetectionLine">
                                        <cf:StatusDot x:Name="DetectionDot" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,7,10,0"
                                                      Kind="{Binding DetectionDot, Converter={StaticResource EnumName}, FallbackValue=Ember}"
                                                      Visibility="{Binding DetectionDot, Converter={StaticResource Is}, ConverterParameter=Ember|Ring}"/>
                                        <!-- a plain text: it changes with every read while scanning, which must not start a moment each time -->
                                        <TextBlock x:Name="DetectionText" Text="{Binding Detection}" Style="{StaticResource CfBody}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="LastSwitchRow" Style="{StaticResource FactsRow}">
                                <StackPanel>
                                    <TextBlock Text="Last switch" Style="{StaticResource CfLabel}" LineHeight="19.6" Margin="0,0,0,3"/>
                                    <TextBlock FontFamily="{StaticResource CfBodyFont}" FontSize="14" LineHeight="20.3" TextWrapping="Wrap" Foreground="{StaticResource CfAshBrush}">
                                        <Run Text="{Binding LastSwitchTime, Mode=OneWay}" Foreground="{StaticResource CfBoneBrush}" FontWeight="SemiBold"/><Run Text="{Binding LastSwitchText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <cf:MapPlate x:Name="Plate" Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- the manual override -->
            <Border x:Name="OverridePanel" Grid.Row="3" Style="{StaticResource CfPanel}" Padding="20,16,20,16" VerticalAlignment="Bottom">
                <Grid x:Name="OverrideGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="OverrideControlsColumn" Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="OverrideSecondRow" Height="0"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Manual override" Style="{StaticResource CfSectionTitle}" LineHeight="24" LineStackingStrategy="BlockLineHeight"/>
                        <!-- what the chosen action does; the full help (when an override ends) is the tool tip and the help
                             text of the focusable controls too, so the keyboard and screen readers reach it -->
                        <TextBlock x:Name="OverrideDescriptionText" Text="{Binding OverrideDescription}" Style="{StaticResource CfDescription}" Margin="0,4,0,0"
                                   ToolTip="{Binding OverrideHelpText}"/>
                    </StackPanel>
                    <StackPanel x:Name="OverrideControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Grid>
                            <ComboBox x:Name="OverrideRealm" Width="232" ItemsSource="{Binding OverrideChoices}"
                                      SelectedItem="{Binding SelectedOverrideRealm, Mode=TwoWay}" AutomationProperties.Name="Realm to force, or Global / Menu"
                                      ToolTip="{Binding OverrideHelpText}" AutomationProperties.HelpText="{Binding OverrideHelpText}"/>
                            <TextBlock Text="Choose a realm" Margin="13,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       FontFamily="{StaticResource CfBodyFont}" FontSize="14" Foreground="{StaticResource CfPlaceholderBrush}"
                                       Visibility="{Binding SelectedOverrideRealm, Converter={StaticResource NoValue}}"/>
                        </Grid>
                        <Button x:Name="ApplyOverrideButton" Content="{Binding ApplyOverrideText}" Style="{StaticResource CfButtonPrimary}" Margin="10,0,0,0" Command="{Binding ApplyOverrideCommand}"
                                ToolTip="{Binding OverrideDescription}" AutomationProperties.HelpText="{Binding OverrideDescription}"/>
                        <Button x:Name="ReturnToAutoButton" Content="Return to automatic" Margin="10,0,0,0" Command="{Binding ReturnToAutoCommand}"
                                ToolTip="{Binding OverrideHelpText}" AutomationProperties.HelpText="{Binding OverrideHelpText}"
                                cf:CampfireAssist.FocusOnLeave="{Binding ElementName=OverrideRealm}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
