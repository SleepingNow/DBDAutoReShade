<!--
    Campfire: the DBD Auto ReShade theme (the approved "a-campfire" prototype).
    Cold fog everywhere; one warm ember where things are alive. Ember = live / confirmed, Entity red = attention.

    Merge it into the application resources:
        <ResourceDictionary Source="/DBDAutoReShade;component/Themes/Campfire.xaml"/>

    What is here:
    - Tokens: colours (Cf*Color), brushes (Cf*Brush), the two embedded font families (CfDisplayFont, CfBodyFont).
      The values live in Media/CampfirePalette.cs and Media/CampfireFonts.cs (one source for the theme and the controls).
    - Type ramp: keyed TextBlock styles (CfHeroXL ... CfRailValue). There is deliberately NO implicit TextBlock style
      (it would reach the text inside other controls' templates).
    - Control templates, keyed, and applied implicitly at the end of this file so nothing ever falls back to the
      Windows light templates: Button (CfButtonSecondary default, CfButtonPrimary, CfButtonGhost, CfButtonDanger,
      the *Small variants, CfTitleBarButton / CfTitleBarCloseButton, CfPlainButton), RadioButton nav item (CfNavItem),
      CheckBox, Slider (fill + thumb), TextBox (placeholder, leading icon, invalid), ComboBox + ComboBoxItem,
      ScrollBar / ScrollViewer (thin fog), ToolTip, ListBox + ListBoxItem realm rows (CfRealmRow), ContextMenu / MenuItem,
      focus visuals (CfFocusVisual, CfFocusVisualInset, CfFocusVisualRow).
    - Press feedback: media:PressFeedback.Scale (0.97 buttons, 0.98 wide rows), 140 ms ease-out, MotionPolicy-aware.
    - Icons: stroke geometries for the nav items, the title-bar glyphs, the hook, the search glyph and the map emblem.
    Sizes are the prototype's at 1280 x 800 (CSS px = WPF DIP). Text contrast is at least 4.5:1 on the night.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:media="clr-namespace:DBDAutoReShade.App.Media"
                    xmlns:cf="clr-namespace:DBDAutoReShade.App.Controls">

    <!-- ===================================================================== tokens -->
    <x:Static x:Key="CfNightColor" Member="media:CampfirePalette.NightColor"/>
    <x:Static x:Key="CfNightDeepColor" Member="media:CampfirePalette.NightDeepColor"/>
    <x:Static x:Key="CfSlateColor" Member="media:CampfirePalette.SlateColor"/>
    <x:Static x:Key="CfMistColor" Member="media:CampfirePalette.MistColor"/>
    <x:Static x:Key="CfBoneColor" Member="media:CampfirePalette.BoneColor"/>
    <x:Static x:Key="CfAshColor" Member="media:CampfirePalette.AshColor"/>
    <x:Static x:Key="CfEmberColor" Member="media:CampfirePalette.EmberColor"/>
    <x:Static x:Key="CfEntityColor" Member="media:CampfirePalette.EntityColor"/>
    <x:Static x:Key="CfEntityInkColor" Member="media:CampfirePalette.EntityInkColor"/>
    <x:Static x:Key="CfNeedleColor" Member="media:CampfirePalette.NeedleColor"/>

    <x:Static x:Key="CfNightBrush" Member="media:CampfirePalette.Night"/>
    <x:Static x:Key="CfNightDeepBrush" Member="media:CampfirePalette.NightDeep"/>
    <x:Static x:Key="CfSlateBrush" Member="media:CampfirePalette.Slate"/>
    <x:Static x:Key="CfMistBrush" Member="media:CampfirePalette.Mist"/>
    <x:Static x:Key="CfBoneBrush" Member="media:CampfirePalette.Bone"/>
    <x:Static x:Key="CfAshBrush" Member="media:CampfirePalette.Ash"/>
    <x:Static x:Key="CfEmberBrush" Member="media:CampfirePalette.Ember"/>
    <x:Static x:Key="CfEntityBrush" Member="media:CampfirePalette.Entity"/>
    <x:Static x:Key="CfEntityInkBrush" Member="media:CampfirePalette.EntityInk"/>
    <x:Static x:Key="CfNeedleBrush" Member="media:CampfirePalette.Needle"/>
    <x:Static x:Key="CfLineBrush" Member="media:CampfirePalette.Line"/>
    <x:Static x:Key="CfLineStrongBrush" Member="media:CampfirePalette.LineStrong"/>
    <!-- a control's own boundary (check box, text field, combo box): >= 3:1, unlike the decorative 28 % line -->
    <x:Static x:Key="CfControlLineBrush" Member="media:CampfirePalette.ControlLine"/>
    <x:Static x:Key="CfPanelBrush" Member="media:CampfirePalette.Panel"/>
    <x:Static x:Key="CfFieldBrush" Member="media:CampfirePalette.Field"/>

    <SolidColorBrush x:Key="CfPlaceholderBrush" po:Freeze="True" Color="#7E888A"/>
    <SolidColorBrush x:Key="CfHoverBrush" po:Freeze="True" Color="#14E3DCCD"/>
    <SolidColorBrush x:Key="CfSelectedBrush" po:Freeze="True" Color="#17E3DCCD"/>
    <SolidColorBrush x:Key="CfRowHoverBrush" po:Freeze="True" Color="#0BE3DCCD"/>
    <!-- a list / menu item the keyboard is on: a stronger wash (with a bone bar in the item templates) -->
    <SolidColorBrush x:Key="CfItemHighlightBrush" po:Freeze="True" Color="#24E3DCCD"/>
    <SolidColorBrush x:Key="CfButtonFillBrush" po:Freeze="True" Color="#0DE3DCCD"/>
    <SolidColorBrush x:Key="CfButtonHoverFillBrush" po:Freeze="True" Color="#1AE3DCCD"/>
    <SolidColorBrush x:Key="CfGhostHoverBrush" po:Freeze="True" Color="#0FE3DCCD"/>
    <SolidColorBrush x:Key="CfBoneHoverBrush" po:Freeze="True" Color="#F4EEE2"/>
    <SolidColorBrush x:Key="CfEntityHoverBrush" po:Freeze="True" Color="#C51E35"/>
    <SolidColorBrush x:Key="CfCheckBoxFillBrush" po:Freeze="True" Color="#B30B1114"/>
    <SolidColorBrush x:Key="CfSliderTrackBrush" po:Freeze="True" Color="#29E3DCCD"/>
    <SolidColorBrush x:Key="CfScrollThumbBrush" po:Freeze="True" Color="#4A5C63"/>
    <SolidColorBrush x:Key="CfScrollThumbHoverBrush" po:Freeze="True" Color="#62767D"/>
    <SolidColorBrush x:Key="CfKeycapFillBrush" po:Freeze="True" Color="#0FE3DCCD"/>
    <!-- the selected nav item's marker (the prototype draws it in bone) -->
    <x:Static x:Key="CfNavMarkerBrush" Member="media:CampfirePalette.Bone"/>

    <!-- one warm ember where things are alive: the live border, and the glow around it -->
    <SolidColorBrush x:Key="CfLiveBorderBrush" po:Freeze="True" Color="#D9F08A3C"/>
    <SolidColorBrush x:Key="CfWaitingBorderBrush" po:Freeze="True" Color="#80F08A3C"/>
    <SolidColorBrush x:Key="CfOverrideBorderBrush" po:Freeze="True" Color="#D9B0182D"/>

    <x:Static x:Key="CfDisplayFont" Member="media:CampfireFonts.Display"/>
    <x:Static x:Key="CfBodyFont" Member="media:CampfireFonts.Body"/>

    <!-- ===================================================================== icons -->
    <!-- nav items: 24 x 24 design units, stroke 1.6, round caps -->
    <Geometry x:Key="CfIconStatus" po:Freeze="True">M12,3 C13.2,6.2 17,8.4 17,13 A5,5 0 0 1 7,13 C7,10.4 8.4,9.2 9.4,7.8 C9.8,9.5 10.7,10.4 11.7,10.7 C11.2,8.3 11,5.6 12,3 Z M5,21 H19</Geometry>
    <Geometry x:Key="CfIconPresets" po:Freeze="True">M4,6 H17 A1,1 0 0 1 18,7 V17 A1,1 0 0 1 17,18 H4 A1,1 0 0 1 3,17 V7 A1,1 0 0 1 4,6 Z M6,3 H21 V15 M3,15 L7.5,11 L11,14 L13.5,12 L18,16</Geometry>
    <Geometry x:Key="CfIconSettings" po:Freeze="True">M4,7 H13 M17,7 H20 M4,17 H7 M11,17 H20 M13,7 A2,2 0 1 1 17,7 A2,2 0 1 1 13,7 Z M7,17 A2,2 0 1 1 11,17 A2,2 0 1 1 7,17 Z M4,12 H16 M19,12 H20 M16,12 A1.5,1.5 0 1 1 19,12 A1.5,1.5 0 1 1 16,12 Z</Geometry>
    <!-- the hook (restart banner, danger zone): 24 x 24, stroke 1.8 -->
    <Geometry x:Key="CfIconHook" po:Freeze="True">M12,1.5 V5.5 M10.4,7.1 A1.6,1.6 0 1 1 13.6,7.1 A1.6,1.6 0 1 1 10.4,7.1 Z M12,8.7 V14.8 A4.2,4.2 0 0 1 3.6,14.8 V12 L6,14</Geometry>
    <!-- the filter box's search glyph: 16 x 16, stroke 1.6 -->
    <Geometry x:Key="CfIconSearch" po:Freeze="True">M2,7 A5,5 0 1 1 12,7 A5,5 0 1 1 2,7 Z M11,11 L15,15</Geometry>
    <!-- the score event's map emblem: 40 x 40, stroke 1.5 -->
    <Geometry x:Key="CfIconMapEmblem" po:Freeze="True">M12,14.5 L17,12.5 L23,14.5 L28,12.5 V25.5 L23,27.5 L17,25.5 L12,27.5 Z M17,12.5 V25.5 M23,14.5 V27.5</Geometry>
    <!-- title-bar glyphs: 10 x 10, stroke 1.1 -->
    <Geometry x:Key="CfGlyphMinimize" po:Freeze="True">M0,5.5 H10</Geometry>
    <Geometry x:Key="CfGlyphMaximize" po:Freeze="True">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="CfGlyphRestore" po:Freeze="True">M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="CfGlyphClose" po:Freeze="True">M0,0 L10,10 M10,0 L0,10</Geometry>
    <!-- the combo box chevron: 10 x 6, stroke 1.4 -->
    <Geometry x:Key="CfGlyphChevron" po:Freeze="True">M1,1 L5,5 L9,1</Geometry>

    <!-- ===================================================================== focus visuals -->
    <!-- :focus-visible { outline: 2px solid bone; outline-offset: 2px } (keyboard focus only, as WPF draws it) -->
    <Style x:Key="CfFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" Stroke="{StaticResource CfBoneBrush}" StrokeThickness="2" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- nav items: outline-offset -3px -->
    <Style x:Key="CfFocusVisualInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" Stroke="{StaticResource CfBoneBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- realm rows: outline-offset -2px -->
    <Style x:Key="CfFocusVisualRow">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="0" Stroke="{StaticResource CfBoneBrush}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== type ramp (TextBlock, keyed) -->
    <!-- The fixed sizes below are the 1280 x 800 values. The ramp steps that the prototype sizes with clamp(..vw..) also set
         cf:CampfireType.Ramp, which re-sizes them to the window (font size, line height, max width; the short-window ramp at
         <= 720 px high). An explicit FontSize / LineHeight / MaxWidth on the element still wins. -->
    <!-- the state hero: Big Shoulders Display 800, line-height .92 (XL: clamp(66px, 7vw, 108px); L: clamp(54px, 5.6vw, 82px),
         max 13ch; M: clamp(40px, 4.1vw, 60px), max 27ch; <= 720 px high: XL clamp(54px, 5.6vw, 82px), L clamp(46px, 4.6vw, 68px)) -->
    <Style x:Key="CfHeroXL" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="90"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="83"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="cf:CampfireType.Ramp" Value="HeroXL"/>
    </Style>
    <Style x:Key="CfHeroL" TargetType="TextBlock" BasedOn="{StaticResource CfHeroXL}">
        <Setter Property="FontSize" Value="72"/>
        <Setter Property="LineHeight" Value="66"/>
        <Setter Property="cf:CampfireType.Ramp" Value="HeroL"/>
    </Style>
    <Style x:Key="CfHeroM" TargetType="TextBlock" BasedOn="{StaticResource CfHeroXL}">
        <Setter Property="FontSize" Value="52"/>
        <Setter Property="LineHeight" Value="48"/>
        <Setter Property="cf:CampfireType.Ramp" Value="HeroM"/>
    </Style>
    <!-- the hero's status line (max-width 70ch) -->
    <Style x:Key="CfHeroMessage" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="21.75"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="cf:CampfireType.Ramp" Value="HeroMessage"/>
    </Style>
    <!-- Presets: the selected realm (clamp(38px, 3.7vw, 54px)) -->
    <Style x:Key="CfDetailTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="47"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="45"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="cf:CampfireType.Ramp" Value="DetailTitle"/>
    </Style>
    <!-- section headings (Settings groups, Manual override): Big Shoulders 600, 24 -->
    <Style x:Key="CfSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- the window title in the title bar -->
    <Style x:Key="CfWindowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- the map plate caption: realm (clamp(28px, 2.8vw, 38px)) and map -->
    <Style x:Key="CfPlateRealm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="cf:CampfireType.Ramp" Value="PlateRealm"/>
    </Style>
    <Style x:Key="CfPlateMap" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Presets: the hero map's name (clamp(24px, 2.3vw, 32px)) -->
    <Style x:Key="CfHeroMap" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="29"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="cf:CampfireType.Ramp" Value="HeroMap"/>
    </Style>
    <!-- a small field label (.k): ash, 13.5, 500 -->
    <Style x:Key="CfLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
    </Style>
    <Style x:Key="CfBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="21.75"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CfBodyMuted" TargetType="TextBlock" BasedOn="{StaticResource CfBody}">
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
    </Style>
    <Style x:Key="CfDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="19.6"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CfHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CfError" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource CfEntityInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Status: the active preset file name (600, 22) -->
    <Style x:Key="CfFileName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="LineHeight" Value="26.4"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Presets: the preset file in the detail panel (500, 20) -->
    <Style x:Key="CfPresetFile" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="LineHeight" Value="25"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CfPresetFileUnset" TargetType="TextBlock" BasedOn="{StaticResource CfPresetFile}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
    </Style>
    <!-- a tag (.tag): ember, 13, 600; the red one reads on the night -->
    <Style x:Key="CfTag" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource CfEmberBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CfTagRed" TargetType="TextBlock" BasedOn="{StaticResource CfTag}">
        <Setter Property="Foreground" Value="{StaticResource CfEntityInkBrush}"/>
    </Style>
    <!-- realm rows -->
    <Style x:Key="CfRowName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="CfRowNameGlobal" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
    </Style>
    <!-- the row's second and third lines keep the prototype's line-height 1.45 (18.85 / 17.4): rows are 72 px apart -->
    <Style x:Key="CfRowPreset" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="18.85"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="CfRowMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="17.4"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- the rail footer: a key (12, ash) and its value (600, 14, bone) -->
    <Style x:Key="CfRailKey" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
    </Style>
    <Style x:Key="CfRailValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
    </Style>
    <Style x:Key="CfRailHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="17.5"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===================================================================== panels and small pieces -->
    <!-- a panel over the fog (override bar, preset panel) -->
    <Style x:Key="CfPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CfPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- a soft night shade under small text that sits straight on the backdrop (the Status line, the Presets map count
         and tag): the map behind the fog can be bright, and the Entity's red rim can cross the text. A blurred night
         block a little larger than the text (give it negative margins) keeps the text at least 4.5:1 over any map. -->
    <Style x:Key="CfTextShade" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource CfNightBrush}"/>
        <Setter Property="Opacity" Value="0.66"/>
        <Setter Property="RadiusX" Value="12"/>
        <Setter Property="RadiusY" Value="12"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <BlurEffect po:Freeze="True" Radius="22" KernelType="Gaussian" RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- a read-only path box (Settings > Paths) -->
    <Style x:Key="CfPathBox" TargetType="Border">
        <Setter Property="Background" Value="#990B1114"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- the ReShade check report well -->
    <Style x:Key="CfReportBox" TargetType="Border">
        <Setter Property="Background" Value="#C2090E10"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- the red flag under a preset panel (restart to load this shortcut) -->
    <Style x:Key="CfFlagBar" TargetType="Border">
        <Setter Property="BorderBrush" Value="#BFB0182D"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush po:Freeze="True" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#61B0182D"/>
                    <GradientStop Offset="1" Color="#1AB0182D"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the danger-zone confirmation -->
    <Style x:Key="CfConfirmBox" TargetType="Border">
        <Setter Property="Background" Value="#24B0182D"/>
        <Setter Property="BorderBrush" Value="#B3B0182D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>
    <!-- the red "Override" pill -->
    <Style x:Key="CfPillRed" TargetType="ContentControl">
        <Setter Property="Foreground" Value="#FBD9DD"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Height="24" Padding="9,0" CornerRadius="2" Background="#80B0182D" BorderBrush="{StaticResource CfEntityBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the ReShade check report tags: OK / Info / Issue (46 x 20) -->
    <Style x:Key="CfReportTagOk" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="BorderBrush" Value="#8CE3DCCD"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Chrome" CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfReportTagInfo" TargetType="ContentControl" BasedOn="{StaticResource CfReportTagOk}">
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Rectangle RadiusX="2" RadiusY="2" Stroke="#8C97A0A2" StrokeThickness="1" StrokeDashArray="3 2" SnapsToDevicePixels="True"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfReportTagIssue" TargetType="ContentControl" BasedOn="{StaticResource CfReportTagOk}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfEntityBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfEntityBrush}"/>
    </Style>

    <!-- ===================================================================== buttons -->
    <!-- .btn: 36 high, 0 16 padding, 2 px radius, bone text 600 / 14; disabled .42; press .97 -->
    <Style x:Key="CfButtonBase" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfButtonFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfLineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="media:PressFeedback.Scale" Value="0.97"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CfButtonSecondary" TargetType="Button" BasedOn="{StaticResource CfButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource CfBoneBrush}"/>
                <Setter Property="Background" Value="{StaticResource CfButtonHoverFillBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CfButtonPrimary" TargetType="Button" BasedOn="{StaticResource CfButtonBase}">
        <Setter Property="Background" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CfNightBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CfBoneHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CfBoneHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CfButtonDanger" TargetType="Button" BasedOn="{StaticResource CfButtonBase}">
        <Setter Property="Background" Value="{StaticResource CfEntityBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfEntityBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CfEntityHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CfEntityHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- .btn.quiet -->
    <Style x:Key="CfButtonGhost" TargetType="Button" BasedOn="{StaticResource CfButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
                <Setter Property="Background" Value="{StaticResource CfGhostHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- .btn.sm: 30 high, 0 12 padding, 13 -->
    <Style x:Key="CfButtonSecondarySmall" TargetType="Button" BasedOn="{StaticResource CfButtonSecondary}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="CfButtonPrimarySmall" TargetType="Button" BasedOn="{StaticResource CfButtonPrimary}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="CfButtonDangerSmall" TargetType="Button" BasedOn="{StaticResource CfButtonDanger}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="CfButtonGhostSmall" TargetType="Button" BasedOn="{StaticResource CfButtonGhost}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- a pressable area with no chrome (thumbnails, composite rows): press .98, outline focus -->
    <Style x:Key="CfPlainButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisual}"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="media:PressFeedback.Scale" Value="0.98"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- title-bar buttons: 46 x 36, a 10 x 10 glyph (cf:CampfireAssist.Icon), stroke 1.1; real buttons with names -->
    <Style x:Key="CfTitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisualInset}"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="media:PressFeedback.Scale" Value="0.97"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <Path Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{Binding Path=(cf:CampfireAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CfHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CfTitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource CfTitleBarButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CfEntityBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== nav item (left rail) -->
    <!-- a RadioButton: 56 high, icon 22 (cf:CampfireAssist.Icon, 24 design units) + label in Big Shoulders 600 / 26;
         selected: bone, a soft wash and a 3 px marker; cf:CampfireAssist.ShowAttention adds the red dot; press .98 -->
    <Style x:Key="CfNavItem" TargetType="RadioButton">
        <Setter Property="Height" Value="56"/>
        <Setter Property="Padding" Value="26,0,20,0"/>
        <Setter Property="Foreground" Value="{StaticResource CfAshBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource CfDisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisualInset}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="media:PressFeedback.Scale" Value="0.98"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Wash" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#1AE3DCCD"/>
                                    <GradientStop Offset="1" Color="#00E3DCCD"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Rectangle x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,10" Fill="{StaticResource CfNavMarkerBrush}" Opacity="0"/>
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Path=(cf:CampfireAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter Margin="14,0,0,2" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Ellipse x:Name="Attention" Width="8" Height="8" Margin="10,0,0,0" VerticalAlignment="Center" Fill="{StaticResource CfEntityBrush}" Visibility="Collapsed">
                                <Ellipse.Effect>
                                    <DropShadowEffect po:Freeze="True" Color="#B0182D" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="1"/>
                            <Setter TargetName="Marker" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="cf:CampfireAssist.ShowAttention" Value="True">
                            <Setter TargetName="Attention" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
            </Trigger>
            <!-- a roving tab stop: Tab enters the sections at the one shown, however it was chosen (the arrows and a click
                 still focus the others) -->
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="IsTabStop" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== check box -->
    <!-- 20 x 20 box (1.5 px line-strong border, field fill), 12 px gap, label 15 bone; checked: a bone box with a night tick -->
    <Style x:Key="CfCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfCheckBoxFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfControlLineBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="20" Height="20" Margin="0,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                CornerRadius="2" BorderThickness="1.5" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Path x:Name="Tick" Data="M3.8,8.6 L7,11.8 L13.4,5.4" Stroke="{StaticResource CfNightBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="21.75"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#B3E3DCCD"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource CfBoneBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CfBoneBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== slider -->
    <Style x:Key="CfSliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfSliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfSliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob" Fill="{StaticResource CfBoneBrush}" Stroke="{StaticResource CfNightBrush}" StrokeThickness="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource CfBoneHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- a 4 px track (bone 16 %) with a bone fill up to the value and an 18 px bone thumb; Foreground = fill colour -->
    <Style x:Key="CfSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfSliderTrackBrush}"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <Border Height="4" CornerRadius="2" Margin="9,0" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource CfSliderFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource CfSliderRest}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CfSliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== scroll bars (thin fog) -->
    <Style x:Key="CfScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfScrollBarThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Background="{StaticResource CfScrollThumbBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource CfScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource CfScrollThumbHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource CfScrollBarPage}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource CfScrollBarPage}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CfScrollBarThumb}" Margin="2,2"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource CfScrollBarPage}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource CfScrollBarPage}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource CfScrollBarThumb}" Margin="2,2"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CfScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource CfScrollBar}" Cursor="Arrow"
                                   AutomationProperties.AutomationId="VerticalScrollBar"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Style="{StaticResource CfScrollBar}" Cursor="Arrow"
                                   AutomationProperties.AutomationId="HorizontalScrollBar"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== text box -->
    <!-- 36 high, 0 12 padding, line-strong border, field fill, bone text 14; focus: bone border; invalid: Entity border;
         cf:CampfireAssist.Placeholder shows while empty; cf:CampfireAssist.Icon adds a leading 16 px glyph (set Padding 36,0,12,0);
         right-click: the Campfire Cut / Copy / Paste / Select all menu (CfTextBoxMenu). WPF builds its own light menu (an
         internal ContextMenu subclass that no implicit style reaches) only while a text box has no ContextMenu. -->
    <Style x:Key="CfTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfControlLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CfEmberBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ContextMenu" Value="{DynamicResource CfTextBoxMenu}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid>
                            <Viewbox x:Name="IconBox" Width="16" Height="16" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Canvas Width="16" Height="16">
                                    <Path Data="{Binding Path=(cf:CampfireAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{StaticResource CfAshBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{Binding Path=(cf:CampfireAssist.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource CfPlaceholderBrush}" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="cf:CampfireAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#B3E3DCCD"/>
                        </Trigger>
                        <Trigger Property="cf:CampfireAssist.IsInvalid" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CfEntityBrush}"/>
                        </Trigger>
                        <!-- (after the invalid border: a focused field always shows its focus; the error under it says why) -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CfBoneBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== selectable text -->
    <!-- read-only text that can be selected and copied (paths, the report's plain text): a text box without chrome,
         bone 14, wrapping; keyboard focus shows the focus ring; right-click: Copy / Select all (CfReadOnlyTextMenu).
         The -2 margin takes back the text box's own 2 px inset, so the text lines up with plain text. -->
    <Style x:Key="CfSelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        <Setter Property="Margin" Value="-2,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CfEmberBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ContextMenu" Value="{DynamicResource CfReadOnlyTextMenu}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"
                                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== combo box -->
    <Style x:Key="CfComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="2" SnapsToDevicePixels="True"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                        <Path Width="10" Height="6" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Data="{StaticResource CfGlyphChevron}" Stroke="{StaticResource CfAshBrush}" StrokeThickness="1.4"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#B3E3DCCD"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CfBoneBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the same field look as the text box: 36 high, chevron at the right; the list opens on slate -->
    <Style x:Key="CfComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfControlLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisual}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="MaxDropDownHeight" Value="300"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource CfComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton x:Name="Toggle" Style="{StaticResource CfComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" Margin="12,0,34,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDown" MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource CfSlateBrush}" BorderBrush="{StaticResource CfLineStrongBrush}" BorderThickness="1" CornerRadius="2"
                                    SnapsToDevicePixels="True" TextElement.Foreground="{StaticResource CfBoneBrush}">
                                <ScrollViewer Style="{StaticResource CfScrollViewer}" Padding="0,4" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource CfBoneBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- the highlighted item (the keyboard's place in the open list, or the pointer's) has a 2 px bone bar at its
                     left edge over a stronger wash, unlike the selected item (a faint wash and semibold text) -->
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle x:Name="KeyBar" Width="2" HorizontalAlignment="Left" Fill="{StaticResource CfBoneBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CfSelectedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CfItemHighlightBrush}"/>
                            <Setter TargetName="KeyBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== tool tip -->
    <Style x:Key="CfToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfSlateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfLineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="2" MaxWidth="360" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== lists (realm rows) -->
    <Style x:Key="CfListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Style="{StaticResource CfScrollViewer}" Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- .row: 8 16 8 18 padding; hover 4.5 %, selected 9 %; inset focus; press .98 -->
    <Style x:Key="CfRealmRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="18,8,16,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CfFocusVisualRow}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="media:PressFeedback.Scale" Value="0.98"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CfRowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CfSelectedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== context menu (the text boxes' Cut / Copy / Paste: CfTextBoxMenu below) -->
    <Style x:Key="CfContextMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Background" Value="{StaticResource CfSlateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CfLineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource CfBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Padding="0,4" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CfMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource CfBoneBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- the highlighted item (keyboard or pointer) has a 2 px bone bar at its left edge over a stronger wash -->
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" MinWidth="140">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Margin="24,0,0,0" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource CfAshBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Rectangle x:Name="KeyBar" Width="2" HorizontalAlignment="Left" Fill="{StaticResource CfBoneBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CfItemHighlightBrush}"/>
                            <Setter TargetName="KeyBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the text boxes' menus (one instance per text box: x:Shared="False"); the commands go to the text box clicked -->
    <ContextMenu x:Key="CfTextBoxMenu" x:Shared="False" Style="{StaticResource CfContextMenu}">
        <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="ApplicationCommands.Cut" Style="{StaticResource CfMenuItem}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" Style="{StaticResource CfMenuItem}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="ApplicationCommands.Paste" Style="{StaticResource CfMenuItem}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll" Style="{StaticResource CfMenuItem}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    </ContextMenu>
    <ContextMenu x:Key="CfReadOnlyTextMenu" x:Shared="False" Style="{StaticResource CfContextMenu}">
        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" Style="{StaticResource CfMenuItem}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll" Style="{StaticResource CfMenuItem}"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    </ContextMenu>

    <!-- ===================================================================== implicit styles: nothing falls back to the light Windows templates -->
    <Style TargetType="Button" BasedOn="{StaticResource CfButtonSecondary}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource CfCheckBox}"/>
    <Style TargetType="Slider" BasedOn="{StaticResource CfSlider}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource CfTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource CfComboBox}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource CfComboBoxItem}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource CfScrollBar}"/>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource CfScrollViewer}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource CfToolTip}"/>
    <Style TargetType="ListBox" BasedOn="{StaticResource CfListBox}"/>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CfRealmRow}"/>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource CfContextMenu}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource CfMenuItem}"/>
</ResourceDictionary>
